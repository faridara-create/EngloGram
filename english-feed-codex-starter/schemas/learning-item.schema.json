{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://english-feed.local/schemas/learning-item.schema.json",
  "title": "Learning Item",
  "type": "object",
  "required": [
    "id",
    "type",
    "term",
    "translationDe",
    "ipa",
    "definitionEn",
    "examples",
    "youglish"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "type": {
      "enum": [
        "vocabulary",
        "collocation"
      ]
    },
    "term": {
      "type": "string"
    },
    "translationDe": {
      "type": "string"
    },
    "ipa": {
      "type": "string"
    },
    "definitionEn": {
      "type": "string"
    },
    "examples": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "en",
          "de"
        ],
        "properties": {
          "en": {
            "type": "string"
          },
          "de": {
            "type": "string"
          }
        }
      }
    },
    "image": {
      "type": "object",
      "properties": {
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "searchPrompt": {
          "type": "string"
        },
        "alt": {
          "type": "string"
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        },
        "license": {
          "type": [
            "string",
            "null"
          ]
        },
        "orientation": {
          "enum": [
            "portrait",
            "landscape",
            "square"
          ]
        },
        "objectPosition": {
          "type": "string",
          "pattern": "^\\d{1,3}% \\d{1,3}%$"
        },
        "safeCropApproved": {
          "type": "boolean"
        },
        "cropNotes": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "url",
        "searchPrompt",
        "alt",
        "source",
        "license",
        "orientation",
        "objectPosition",
        "safeCropApproved",
        "cropNotes"
      ]
    },
    "audio": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "voice": {
          "type": "string"
        }
      }
    },
    "youglish": {
      "type": "object",
      "required": [
        "query"
      ],
      "properties": {
        "query": {
          "type": "string"
        }
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
